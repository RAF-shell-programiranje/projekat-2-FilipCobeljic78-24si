[Unit]
Description=Dummy Service - Simple Java Application for Logging
Documentation=https://github.com/{{ github_repo_owner }}/{{ github_repo_name }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User={{ dummy_service_user }}
Group={{ dummy_service_group }}

WorkingDirectory={{ dummy_service_install_dir }}

Environment="JAVA_HOME=/usr/lib/jvm/java-{{ java_version }}-openjdk-amd64"

Environment="PATH=/usr/lib/jvm/java-{{ java_version }}-openjdk-amd64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ExecStart=/usr/bin/java {{ java_opts }} -jar {{ dummy_service_jar_path }}

StandardOutput=append:{{ dummy_service_log_file }}
StandardError=append:{{ dummy_service_log_file }}

Restart=on-failure

RestartSec=10

StartLimitInterval=200
StartLimitBurst=5

NoNewPrivileges=true

PrivateTmp=true

ProtectSystem=strict

ProtectHome=true

ReadWritePaths={{ dummy_service_log_path }}

[Install]
WantedBy=multi-user.target
